#!/bin/bash -x
#SBATCH --account=hai_1223
#SBATCH --cpus-per-task=48
#SBATCH --gres=gpu:1
#SBATCH --output=out/score.%j.out
#SBATCH --error=err/score.%j.err
#SBATCH --time=02:00:00
#SBATCH --partition=booster

export SRUN_CPUS_PER_TASK="$SLURM_CPUS_PER_TASK"

REPO_ROOT="${SLURM_SUBMIT_DIR:-$(pwd)}"
source "$REPO_ROOT/../venv_setup/activate.sh"
cd "$REPO_ROOT"

# Edit these values before submitting the job. EVAL_NAME and MODEL_NAME must
# match the generation job.
EVAL_NAME="my_eval"
MODEL_NAME="transformer_pretrained"
SCORER_CONFIG="src/eval/configs/default.yml"

MODEL_DIR="data/evals/$EVAL_NAME/$MODEL_NAME"

srun python3 src/eval/score_sequences.py \
    --config "$SCORER_CONFIG" \
    --samples_csv "$MODEL_DIR/sequences.csv" \
    --save_dir "$MODEL_DIR"
